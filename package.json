{
  "name": "overpass-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node apps/game/node_modules/vite/bin/vite.js apps/game --open",
    "dev:studio": "node apps/studio/node_modules/vite/bin/vite.js apps/studio",
    "build": "pnpm --filter @overpass-game/game --filter @overpass-game/studio run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "compile-maps": "pnpm --filter @overpass-game/tools run compile-maps"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
